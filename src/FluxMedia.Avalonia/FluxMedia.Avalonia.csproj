<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>FluxMedia.Avalonia</PackageId>
    <Version>$(FluxMediaVersion)</Version>
    <Authors>FluxMedia</Authors>
    <Description>Avalonia 11/12 playback controls for FluxMedia on .NET 6 and later, targeting .NET Standard 2.1.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageReleaseNotes>FluxMedia $(FluxMediaVersion): bounds GPU image import caching, releases lost and evicted resources, clears stale GPU output and filters obsolete presentation tasks. Improves recording binding notifications and diagnostic reads. Logging uses LogConverge.Sharp through FluxMedia.Playback. Depends on FluxMedia.Playback $(FluxMediaVersion); existing PlayerBinding and customizable control templates are retained.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Avalonia" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxMedia.Playback\FluxMedia.Playback.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\CompilerServices\IsExternalInit.cs" Link="CompilerServices\IsExternalInit.cs" />
  </ItemGroup>
</Project>
